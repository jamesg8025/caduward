# Copy to .env and fill in values before running locally.
# All variables are prefixed CADUWARD_ per the naming convention.

# PostgreSQL (matches docker-compose defaults)
CADUWARD_DATABASE_URL=postgresql://caduward:caduward@localhost:5433/caduward

# Redis (matches docker-compose defaults)
CADUWARD_REDIS_URL=redis://localhost:6379

# Claude API — get a key at https://console.anthropic.com
CADUWARD_ANTHROPIC_API_KEY=

# Auth secret — generate with: openssl rand -hex 32
CADUWARD_AUTH_SECRET=

# Base URL for the web app (used by better-auth)
CADUWARD_BASE_URL=http://localhost:3000

# Socket.IO server port (worker) and URL (web client)
CADUWARD_SOCKET_PORT=3001
NEXT_PUBLIC_CADUWARD_SOCKET_URL=http://localhost:3001

# Claude model for explanations (default: claude-haiku-4-5-20251001)
CADUWARD_CLAUDE_MODEL=claude-haiku-4-5-20251001

# Explanation provider: "claude" | "ollama"
CADUWARD_EXPLAIN_PROVIDER=claude

# Ollama endpoint (only needed when CADUWARD_EXPLAIN_PROVIDER=ollama)
CADUWARD_OLLAMA_BASE_URL=http://localhost:11434
CADUWARD_OLLAMA_MODEL=llama3.2
